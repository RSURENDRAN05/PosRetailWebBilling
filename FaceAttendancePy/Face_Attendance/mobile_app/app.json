{
  "expo": {
    "name": "Face Attendance",
    "slug": "face-attendance",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2C3E50"
    },
    "plugins": [
      ["expo-camera", {
        "cameraPermission": "Allow Face Attendance to access your camera for face recognition attendance."
      }],
      ["expo-location", {
        "locationAlwaysAndWhenInUsePermission": "Allow Face Attendance to use your location to verify you are at the office.",
        "locationWhenInUsePermission": "Allow Face Attendance to use your location for attendance verification."
      }]
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2C3E50"
      },
      "package": "com.faceattendance.app",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.faceattendance.app",
      "infoPlist": {
        "NSCameraUsageDescription":         "Used for face recognition attendance",
        "NSLocationWhenInUseUsageDescription": "Used to verify you are at the office",
        "NSFaceIDUsageDescription":         "Used for biometric attendance verification"
      }
    },
    "web": { "favicon": "./assets/favicon.png" }
  }
}
